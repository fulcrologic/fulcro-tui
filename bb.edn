;; ===========================================================================
;; Babashka target for fulcro-tui (the terminal UI engine).
;;
;; The TUI loads and runs under babashka. The historical blockers were in Fulcro CORE and are resolved
;; as of the Fulcro build this depends on:
;;
;;   1. Fulcro's `Mutation` `deftype` implements `clojure.lang.IFn`, which bb's SCI could not
;;      construct — `defmutation` now loads and runs.
;;   2. The transitively-pulled `org.clojure/spec.alpha` and `org.clojure/clojurescript` jars no longer
;;      shadow bb's built-ins.
;;
;; A third, bb-specific blocker lived here in the TUI: JLine's resize signal API
;; (`Terminal$Signal`/`Terminal$SignalHandler`) uses INNER classes that SCI can neither resolve nor
;; `reify`. terminal.cljc routes SIGWINCH through the top-level `sun.misc.Signal`/`SignalHandler`
;; instead, which works on both the JVM and bb.
;;
;; Run the example TUI form in a real terminal with:  bb run tui   (or: bb tui)
;;
;; Note: babashka bundles JLine, so there is intentionally no org.jline/jline dependency here.
;; ===========================================================================
{:paths ["src/main" "src/tui-example"]
 :deps  {com.fulcrologic/fulcro {:mvn/version "3.10.0-RC2"}}
 :tasks {tui  {:doc      "Run the example TUI form in the current terminal (Ctrl-Q quits)."
               :requires ([tui-example.form])
               :task     (tui-example.form/-main)}

         ;; ---------------------------------------------------------------------
         ;; Babashka test runner. Runs the engine's specs under bb itself, so the bb-target code stays
         ;; honestly green on bb (not just on the JVM). fulcro-spec >= 3.2.10 loads and runs under bb.
         ;; The set is explicit (not glob discovery) so adding a spec that pulls something
         ;; bb-incompatible fails loudly here instead of silently skipping.
         ;; ---------------------------------------------------------------------
         test {:doc         "Run the engine specs under babashka (fulcro-spec, same files as the JVM suite)."
               :extra-paths ["src/test"]
               :extra-deps  {fulcrologic/fulcro-spec {:mvn/version "3.2.10"
                                                      :exclusions  [com.fulcrologic/fulcro
                                                                    org.clojure/clojurescript
                                                                    org.clojure/spec.alpha]}
                             org.clojure/test.check  {:mvn/version "1.1.1"}}
               :requires    ([clojure.test :as t])
               :task        (let [bb-specs '[com.fulcrologic.fulcro.tui.application-spec
                                             com.fulcrologic.fulcro.tui.buffered-input-spec
                                             com.fulcrologic.fulcro.tui.elements-spec
                                             com.fulcrologic.fulcro.tui.engine-spec
                                             com.fulcrologic.fulcro.tui.terminal-spec
                                             com.fulcrologic.fulcro.tui.perf-spec]]
                              (doseq [n bb-specs] (require n))
                              (let [{:keys [fail error]} (apply t/run-tests bb-specs)]
                                (System/exit (if (pos? (+ (long fail) (long error))) 1 0))))}}}
